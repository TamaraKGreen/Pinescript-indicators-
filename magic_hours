           v_break_side == 1  ? "HIGH Break ↑" : "LOW Break ↓"
    table.cell(tbl, 0, row, "Break", bgcolor=CEL_BG, text_color=CEL_TX,
         text_size=ts, text_font_family=font.family_monospace)
    table.cell(tbl, 1, row, bstr, bgcolor=CEL_BG, text_color=CEL_TX,
         text_size=ts, text_font_family=font.family_monospace)
    row += 1

    // Zone
    if v_break_side != 0 and v_cur_zone >= 0
        zw  = zone_win(v_cur_zone, v_z1w, v_z2w, v_z3w, v_z4w, v_z5w, v_z6w)
        zn  = zone_name(v_cur_zone)
        zst = zone_status(v_cur_zone)
        zbg = v_cur_zone == 0 ? color.new(color.gray,   60) : 
                 v_cur_zone == 1 ? color.new(color.blue,   60) : 
                 v_cur_zone == 2 ? color.new(color.green,  60) : 
                 v_cur_zone == 3 ? color.new(color.orange, 60) : 
                 v_cur_zone == 4 ? color.new(color.red,    60) : 
                                   color.new(#37474f,      60)
        table.cell(tbl, 0, row, "Zone | Win Rate", bgcolor=CEL_BG, text_color=CEL_TX,
             text_size=ts, text_font_family=font.family_monospace)
        table.cell(tbl, 1, row,
             zn + " — " + zst + " | " + str.tostring(zw, "#.#") + "%",
             bgcolor=zbg, text_color=color.white,
             text_size=ts, text_font_family=font.family_monospace)
        row += 1

    // Runners
    if v_tgt_hit
        table.cell(tbl, 0, row, "── RUNNERS ──", bgcolor=SUB_BG, text_color=HDR_TX,
             text_size=ts, text_font_family=font.family_monospace)
        table.cell(tbl, 1, row, "Conditional %", bgcolor=SUB_BG, text_color=HDR_TX,
             text_size=ts, text_font_family=font.family_monospace)
        row += 1

        r_pcts = array.from(v_r75, v_r100, v_r125, v_r150, v_r200)
        r_lvls = array.from("75%", "100%", "125%", "150%", "200%")
        r_acts = array.from("Hold", "Hold", "Trail Stop", "Trail/Partial", "Take Partial")

        for r = 0 to 4
            rp  = array.get(r_pcts, r)
            rl  = array.get(r_lvls, r)
            ra  = array.get(r_acts, r)
            rbg = rp >= 80.0 ? color.new(color.green,  70) : 
                  rp >= 60.0 ? color.new(color.teal,   70) : 
                  rp >= 40.0 ? color.new(color.yellow, 70) : 
                               color.new(color.red,    70)
            table.cell(tbl, 0, row, rl + "  " + ra, bgcolor=CEL_BG,
                 text_color=CEL_TX, text_size=ts, text_font_family=font.family_monospace)
            table.cell(tbl, 1, row, str.tostring(rp, "#.#") + "%",
                 bgcolor=rbg, text_color=CEL_TX,
                 text_size=ts, text_font_family=font.family_monospace)
            row += 1

    // Median time
    if v_setup_rdy and not na(v_t50)
        table.cell(tbl, 0, row, "Median Time", bgcolor=CEL_BG, text_color=CEL_TX,
             text_size=ts, text_font_family=font.family_monospace)
        table.cell(tbl, 1, row, str.tostring(v_t50) + " min",
             bgcolor=CEL_BG, text_color=CEL_TX,
             text_size=ts, text_font_family=font.family_monospace)

