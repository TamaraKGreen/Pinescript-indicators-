            elapsed_m   = (now_ms - tgt_ms) / 60000
            remaining_m = math.round(-elapsed_m)
            passed      = elapsed_m >= 0

            status_str = passed ?
                 str.tostring(math.round(elapsed_m)) + "m ago ✓" : 
                 str.tostring(remaining_m) + "m left"

            remaining_frac = passed ? 0.0 : remaining_m / float(pmin)
            cell_bg = passed ?
                 color.new(color.green,  50) : 
                 remaining_frac > 0.5 ?
                 color.new(#1a3a5c,      20) : 
                 remaining_frac > 0.2 ?
                 color.new(color.orange, 60) : 
                 color.new(color.red,    50)
            txt_col = passed ? color.new(color.green, 20) : color.white

            table.cell(ctbl, 0, 3 + pi, plbl, bgcolor=color.white,
                 text_color=color.rgb(40,40,40), text_size=ts,
                 text_font_family=font.family_monospace)
            table.cell(ctbl, 1, 3 + pi, tgt_str, bgcolor=color.white,
                 text_color=color.rgb(80,80,80), text_size=ts,
                 text_font_family=font.family_monospace)
            table.cell(ctbl, 2, 3 + pi, status_str,
                 bgcolor=cell_bg, text_color=txt_col, text_size=ts,
                 text_font_family=font.family_monospace)

        // Hard stop row
        if not na(v_hard_stop_ts)
            hs_elapsed   = (now_ms - v_hard_stop_ts) / 60000
            hs_remaining = math.round(-hs_elapsed)
            hs_passed    = hs_elapsed >= 0
            hs_str  = hs_passed ? "EXPIRED" : str.tostring(hs_remaining) + "m left"
            hs_bg   = hs_passed ? color.new(color.red, 40) : color.rgb(40, 20, 20)
            hs_tc   = hs_passed ? color.white : color.new(color.red, 20)
            hs_time = str.format_time(v_hard_stop_ts, "HH:mm", "America/New_York")
            table.cell(ctbl, 0, 7, "Hard Stop", bgcolor=color.rgb(255,235,235),
