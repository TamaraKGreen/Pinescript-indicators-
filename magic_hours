             frame_width=2)

        ts     = tbl_sz(i_ctbl_size)
        now_ms = timenow

        // Header
        table.cell(ctbl, 0, 0, "TIME TO TARGET", bgcolor=color.rgb(40,40,40),
             text_color=color.white, text_size=ts,
             text_font_family=font.family_monospace)
        table.cell(ctbl, 1, 0, "", bgcolor=color.rgb(40,40,40), text_size=ts)
        table.cell(ctbl, 2, 0, "", bgcolor=color.rgb(40,40,40), text_size=ts)

        // Break time row
        break_str = "Break: " + str.format_time(v_break_time, "HH:mm", "America/New_York") + " NY"
        table.cell(ctbl, 0, 1, break_str, bgcolor=color.rgb(240,240,240),
             text_color=color.rgb(60,60,60), text_size=ts,
             text_font_family=font.family_monospace)
        table.cell(ctbl, 1, 1, "", bgcolor=color.rgb(240,240,240), text_size=ts)
        table.cell(ctbl, 2, 1, "", bgcolor=color.rgb(240,240,240), text_size=ts)

        // Column headers
        table.cell(ctbl, 0, 2, "Percentile", bgcolor=color.rgb(40,40,40),
             text_color=color.rgb(150,150,150), text_size=ts,
             text_font_family=font.family_monospace)
        table.cell(ctbl, 1, 2, "Target",     bgcolor=color.rgb(40,40,40),
             text_color=color.rgb(150,150,150), text_size=ts,
             text_font_family=font.family_monospace)
        table.cell(ctbl, 2, 2, "Status",     bgcolor=color.rgb(40,40,40),
             text_color=color.rgb(150,150,150), text_size=ts,
             text_font_family=font.family_monospace)

        // Percentile rows
        pct_labels = array.from("25% (fast)", "Median", "75% (slow)", "90% (grind)")
        pct_mins   = array.from(v_tp25, v_tp50, v_tp75, v_tp90)

        for pi = 0 to 3
            plbl = array.get(pct_labels, pi)
            pmin = array.get(pct_mins,   pi)
            tgt_ms  = v_break_time + pmin * 60000
