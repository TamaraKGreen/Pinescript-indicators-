// === Helper Functions ===
get_line_style(style_string) =>
    style_string == "Solid" ? line.style_solid : style_string == "Dashed" ? line.style_dashed : line.style_dotted

get_label_size(size_string) =>
    size_string == "Tiny" ? size.tiny : size_string == "Small" ? size.small : size_string == "Normal" ? size.normal : size.large

get_label_style() =>
    label.style_label_left

// === Session Detection ===
is_in_session = not na(time(timeframe.period, session_time, time_zone))
is_session_start = is_in_session and not is_in_session[1]
is_session_end = not is_in_session and is_in_session[1]

// === Session Data Tracking ===
var float session_open = na
var float session_high = na
var float session_low = na
var float session_close = na

if is_session_start
    session_open := open
    session_high := high
    session_low := low
    session_close := close
else if is_in_session
    session_high := math.max(session_high, high)
    session_low := math.min(session_low, low)
    session_close := close

// === Arrays and Counters ===
var float[] manipulation_distances = array.new_float(0)
var float[] distribution_distances = array.new_float(0)
var float[] upward_expansions = array.new_float(0)
var float[] downward_expansions = array.new_float(0)
var float[] session_ranges = array.new_float(0)
var float[] session_closes = array.new_float(0)
var float[] session_opens = array.new_float(0)
var float[] session_highs = array.new_float(0)
var float[] session_lows = array.new_float(0)
var int[] session_types = array.new_int(0)
var int bullish_count = 0
var int bearish_count = 0
var int above_manip_count = 0
var int below_manip_count = 0
var int above_dist_count = 0
var int below_dist_count = 0

// === Statistics Calculation ===
if is_session_end
    int session_type = 0
    float manipulation = na
    float distribution = na
    float upward_expansion = session_high - session_open
    float downward_expansion = session_open - session_low
    float session_range = session_high - session_low
    
    if session_close > session_open
        manipulation := session_open - session_low
        distribution := session_high - session_open
        session_type := 1
    else if session_close < session_open
        manipulation := session_high - session_open
        distribution := session_open - session_low
        session_type := -1
    
    if not na(session_type) and session_type != 0
        // Push data to arrays
        array.push(manipulation_distances, manipulation)
        array.push(distribution_distances, distribution)
        array.push(upward_expansions, upward_expansion)
        array.push(downward_expansions, downward_expansion)
        array.push(session_ranges, session_range)
        array.push(session_closes, session_close)
        array.push(session_opens, session_open)
        array.push(session_highs, session_high)
        array.push(session_lows, session_low)
        array.push(session_types, session_type)
        if session_type == 1
            bullish_count := bullish_count + 1
        else
            bearish_count := bearish_count + 1
        
        // Calculate averages
        float avg_manipulation = array.size(manipulation_distances) > 0 ? array.avg(manipulation_distances) : na
        float avg_distribution = array.size(distribution_distances) > 0 ? array.avg(distribution_distances) : na
        
        // Check if close is above/below manipulation levels
        if not na(avg_manipulation)
            if session_close > session_open + avg_manipulation
                above_manip_count := above_manip_count + 1
            if session_close < session_open - avg_manipulation
                below_manip_count := below_manip_count + 1
        
        // Check if close is above/below distribution levels
        if not na(avg_distribution)
            if session_close > session_open + avg_distribution
                above_dist_count := above_dist_count + 1
            if session_close < session_open - avg_distribution
                below_dist_count := below_dist_count + 1
        
        // Maintain array size
        if array.size(session_types) > hist_sessions
            int old_type = array.shift(session_types)
            if old_type == 1
                bullish_count := math.max(0, bullish_count - 1)
            else
                bearish_count := math.max(0, bearish_count - 1)
            array.shift(manipulation_distances)
            array.shift(distribution_distances)
            array.shift(upward_expansions)
            array.shift(downward_expansions)
            array.shift(session_ranges)
            float old_close = array.shift(session_closes)
            float old_open = array.shift(session_opens)
            array.shift(session_highs)
            array.shift(session_lows)
            // Recalculate averages for removed session
            float hist_avg_manip = array.size(manipulation_distances) > 0 ? array.avg(manipulation_distances) : na
            float hist_avg_dist = array.size(distribution_distances) > 0 ? array.avg(distribution_distances) : na
            // Check if removed close was above/below manipulation
            if not na(hist_avg_manip) and not na(old_open) and not na(old_close)
                if old_close > old_open + hist_avg_manip
                    above_manip_count := math.max(0, above_manip_count - 1)
                if old_close < old_open - hist_avg_manip
                    below_manip_count := math.max(0, below_manip_count - 1)
            // Check if removed close was above/below distribution
            if not na(hist_avg_dist) and not na(old_open) and not na(old_close)
                if old_close > old_open + hist_avg_dist
                    above_dist_count := math.max(0, above_dist_count - 1)
                if old_close < old_open - hist_avg_dist
                    below_dist_count := math.max(0, below_dist_count - 1)

// === Calculate Averages, Medians, and Statistics ===
var float avg_manipulation = na
var float avg_distribution = na
var float median_manipulation = na
var float median_distribution = na
var float mean_upward_expansion = na
var float median_upward_expansion = na
var float mean_downward_expansion = na
var float median_downward_expansion = na
var float avg_session_range = na
var float stdev_session_range = na
var float latest_range = na
var float z_score = na
var float pct_above_manip = na
var float pct_below_manip = na
var float pct_above_dist = na
var float pct_below_dist = na

if is_session_end
    avg_manipulation := array.size(manipulation_distances) > 0 ? array.avg(manipulation_distances) : na
    avg_distribution := array.size(distribution_distances) > 0 ? array.avg(distribution_distances) : na
    median_manipulation := array.size(manipulation_distances) > 0 ? array.median(manipulation_distances) : na
    median_distribution := array.size(distribution_distances) > 0 ? array.median(distribution_distances) : na
    mean_upward_expansion := array.size(upward_expansions) > 0 ? array.avg(upward_expansions) : na
    median_upward_expansion := array.size(upward_expansions) > 0 ? array.median(upward_expansions) : na
    mean_downward_expansion := array.size(downward_expansions) > 0 ? array.avg(downward_expansions) : na
    median_downward_expansion := array.size(downward_expansions) > 0 ? array.median(downward_expansions) : na
    avg_session_range := array.size(session_ranges) > 0 ? array.avg(session_ranges) : na
    stdev_session_range := array.size(session_ranges) > 0 ? array.stdev(session_ranges) : na
    latest_range := array.size(session_ranges) > 0 ? array.get(session_ranges, array.size(session_ranges) - 1) : na
    z_score := stdev_session_range != 0 ? (latest_range - avg_session_range) / stdev_session_range : na
    pct_above_manip := array.size(session_types) > 0 ? math.max(0, math.min(100, (above_manip_count / array.size(session_types)) * 100)) : na
    pct_below_manip := array.size(session_types) > 0 ? math.max(0, math.min(100, (below_manip_count / array.size(session_types)) * 100)) : na
    pct_above_dist := array.size(session_types) > 0 ? math.max(0, math.min(100, (above_dist_count / array.size(session_types)) * 100)) : na
    pct_below_dist := array.size(session_types) > 0 ? math.max(0, math.min(100, (below_dist_count / array.size(session_types)) * 100)) : na

// === Plotting Levels and Labels ===
var line anchor_line = na
var label anchor_label = na
var line session_open_line = na
var label session_open_label = na
