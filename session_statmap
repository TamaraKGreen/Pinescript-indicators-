// Function to determine session based on current time (in New York timezone)
f_getAutoSession() =>
    // Get current timestamp (timenow is in UTC)
    var int current_time = timenow
    
    // Extract hour and minute in New York timezone
    var int current_hour = hour(time=current_time, timezone="America/New_York")
    var int current_minute = minute(time=current_time, timezone="America/New_York")
    var float current_time_decimal = current_hour + current_minute / 60.0
    
    // Default session (fallback)
    var string auto_session_time = "0930-1600" // Default to New York RTH
    var string auto_time_zone = "America/New_York"
    var string session_name = "New York RTH"
    
    // Check sessions using decimal time for clarity
    // Midnight to 5pm: 00:00 - 17:00
    if current_time_decimal >= 0.0 and current_time_decimal < 17.0
        auto_session_time := "0000-1700"
        auto_time_zone := "America/New_York"
        session_name := "Midnight to 5pm"
    // London: 2:00 AM - 8:00 AM
    else if current_time_decimal >= 2.0 and current_time_decimal < 8.0
        auto_session_time := "0200-0800"
        auto_time_zone := "America/New_York"
        session_name := "London"
    // New York Futures: 8:00 AM - 5:00 PM (17:00)
    else if current_time_decimal >= 8.0 and current_time_decimal < 17.0
        auto_session_time := "0800-1700"
        auto_time_zone := "America/New_York"
        session_name := "New York Futures"
    // New York RTH: 9:30 AM - 4:00 PM (16:00)
    else if current_time_decimal >= 9.5 and current_time_decimal < 16.0
        auto_session_time := "0930-1600"
        auto_time_zone := "America/New_York"
        session_name := "New York RTH"
    // Asia: 7:00 PM (19:00) - 2:00 AM (next day)
    else if current_time_decimal >= 19.0 or current_time_decimal < 2.0
        auto_session_time := "1900-0200"
        auto_time_zone := "America/New_York"
        session_name := "Asia"
    
    [auto_session_time, auto_time_zone, session_name]

// Determine session time and timezone
var string session_time = ""
var string time_zone = ""
var string display_session_name = session_choice
if session_choice == "Auto" 
    [auto_session, auto_zone, auto_name] = f_getAutoSession()
    session_time := auto_session
    time_zone := auto_zone
    display_session_name := auto_name
else
    switch session_choice
        "New York RTH (9.30am - 4pm)" =>
            session_time := "0930-1600"
            time_zone := "America/New_York"
            display_session_name := "New York RTH"
        "New York Futures (8am - 5pm)" =>
            session_time := "0800-1700"
            time_zone := "America/New_York"
            display_session_name := "New York Futures"
        "London (2am - 8am)" =>
            session_time := "0200-0800"
            time_zone := "America/New_York"
            display_session_name := "London"
        "Asia (7pm - 2am)" =>
            session_time := "1900-0200"
            time_zone := "America/New_York"
            display_session_name := "Asia"
        "Midnight to 5pm" =>
            session_time := "0000-1700"
            time_zone := "America/New_York"
            display_session_name := "Midnight to 5pm"
        "Custom" =>
            session_time := custom_session_start + "-" + custom_session_end
            time_zone := "America/New_York"
            display_session_name := "Custom (9am-12noon EST)"

