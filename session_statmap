var label upper_median_manip_label = na
var line lower_median_manip_line = na
var label lower_median_manip_label = na
var line upper_median_dist_line = na
var label upper_median_dist_label = na
var line lower_median_dist_line = na
var label lower_median_dist_label = na
var line upper_mean_expansion_line = na
var label upper_mean_expansion_label = na
var line lower_mean_expansion_line = na
var label lower_mean_expansion_label = na
var line upper_median_expansion_line = na
var label upper_median_expansion_label = na
var line lower_median_expansion_line = na
var label lower_median_expansion_label = na
var line range_median_line = na
var label range_median_label = na
var box upper_manip_shading = na
var box lower_manip_shading = na
var box upper_dist_shading = na
var box lower_dist_shading = na

if bar_index == 0
    anchor_line := line.new(bar_index, na, bar_index, na, xloc.bar_index, extend.both, anchor_color, get_line_style(anchor_style), anchor_width)
    anchor_label := label.new(bar_index, na, "Session Start", style=label.style_label_right, color=color.new(anchor_color, 100), textcolor=anchor_color, size=get_label_size(label_size))
    session_open_line := line.new(bar_index, na, bar_index+1, na, color=session_open_color, style=get_line_style(session_open_style), width=session_open_width)
    session_open_label := label.new(bar_index, na, "Session Open", style=get_label_style(), color=color.new(session_open_color, 100), textcolor=session_open_color, size=get_label_size(label_size))
    upper_manipulation_line := line.new(bar_index, na, bar_index+1, na, color=manipulation_color, style=get_line_style(manipulation_style), width=manipulation_width)
    upper_manipulation_label := label.new(bar_index, na, "-M", style=get_label_style(), color=color.new(manipulation_color, 100), textcolor=manipulation_color, size=get_label_size(label_size))
    lower_manipulation_line := line.new(bar_index, na, bar_index+1, na, color=manipulation_color, style=get_line_style(manipulation_style), width=manipulation_width)
    lower_manipulation_label := label.new(bar_index, na, "+M", style=get_label_style(), color=color.new(manipulation_color, 100), textcolor=manipulation_color, size=get_label_size(label_size))
    upper_distribution_line := line.new(bar_index, na, bar_index+1, na, color=distribution_color, style=get_line_style(distribution_style), width=distribution_width)
    upper_distribution_label := label.new(bar_index, na, "+D", style=get_label_style(), color=color.new(distribution_color, 100), textcolor=distribution_color, size=get_label_size(label_size))
    lower_distribution_line := line.new(bar_index, na, bar_index+1, na, color=distribution_color, style=get_line_style(distribution_style), width=distribution_width)
    lower_distribution_label := label.new(bar_index, na, "-D", style=get_label_style(), color=color.new(distribution_color, 100), textcolor=distribution_color, size=get_label_size(label_size))
    upper_median_manip_line := line.new(bar_index, na, bar_index+1, na, color=median_color, style=get_line_style(median_style), width=median_width)
    upper_median_manip_label := label.new(bar_index, na, "-M Median", style=get_label_style(), color=color.new(median_color, 100), textcolor=median_color, size=get_label_size(label_size))
    lower_median_manip_line := line.new(bar_index, na, bar_index+1, na, color=median_color, style=get_line_style(median_style), width=median_width)
    lower_median_manip_label := label.new(bar_index, na, "+M Median", style=get_label_style(), color=color.new(median_color, 100), textcolor=median_color, size=get_label_size(label_size))
    upper_median_dist_line := line.new(bar_index, na, bar_index+1, na, color=median_color, style=get_line_style(median_style), width=median_width)
    upper_median_dist_label := label.new(bar_index, na, "+D Median", style=get_label_style(), color=color.new(median_color, 100), textcolor=median_color, size=get_label_size(label_size))
    lower_median_dist_line := line.new(bar_index, na, bar_index+1, na, color=median_color, style=get_line_style(median_style), width=median_width)
    lower_median_dist_label := label.new(bar_index, na, "-D Median", style=get_label_style(), color=color.new(median_color, 100), textcolor=median_color, size=get_label_size(label_size))
    upper_mean_expansion_line := line.new(bar_index, na, bar_index+1, na, color=expansion_color, style=get_line_style(expansion_style), width=expansion_width)
    upper_mean_expansion_label := label.new(bar_index, na, "+Exp Mean", style=get_label_style(), color=color.new(expansion_color, 100), textcolor=expansion_color, size=get_label_size(label_size))
    lower_mean_expansion_line := line.new(bar_index, na, bar_index+1, na, color=expansion_color, style=get_line_style(expansion_style), width=expansion_width)
    lower_mean_expansion_label := label.new(bar_index, na, "-Exp Mean", style=get_label_style(), color=color.new(expansion_color, 100), textcolor=expansion_color, size=get_label_size(label_size))
    upper_median_expansion_line := line.new(bar_index, na, bar_index+1, na, color=expansion_color, style=get_line_style(expansion_style), width=expansion_width)
    upper_median_expansion_label := label.new(bar_index, na, "+Exp Med", style=get_label_style(), color=color.new(expansion_color, 100), textcolor=expansion_color, size=get_label_size(label_size))
    lower_median_expansion_line := line.new(bar_index, na, bar_index+1, na, color=expansion_color, style=get_line_style(expansion_style), width=expansion_width)
    lower_median_expansion_label := label.new(bar_index, na, "-Exp Med", style=get_label_style(), color=color.new(expansion_color, 100), textcolor=expansion_color, size=get_label_size(label_size))
    range_median_line := line.new(bar_index, na, bar_index+1, na, color=range_median_color, style=get_line_style(range_median_style), width=range_median_width)
    range_median_label := label.new(bar_index, na, "Range Mid", style=get_label_style(), color=color.new(range_median_color, 100), textcolor=range_median_color, size=get_label_size(label_size))
    upper_manip_shading := box.new(bar_index, na, bar_index+1, na, bgcolor=shading_manip_color, border_width=0)
    lower_manip_shading := box.new(bar_index, na, bar_index+1, na, bgcolor=shading_manip_color, border_width=0)
    upper_dist_shading := box.new(bar_index, na, bar_index+1, na, bgcolor=shading_dist_color, border_width=0)
    lower_dist_shading := box.new(bar_index, na, bar_index+1, na, bgcolor=shading_dist_color, border_width=0)

// Session Anchor (Vertical Line with Extend Both)
if is_session_start and show_anchor
    line.set_xy1(anchor_line, bar_index, session_open)
    line.set_xy2(anchor_line, bar_index, session_open)
    if show_anchor_label and not na(avg_distribution)
        anchor_label_x = bar_index
        label.set_xy(anchor_label, anchor_label_x, session_open + avg_distribution)

// Session Open Line
if is_session_start and show_session_open
    line.set_xy1(session_open_line, bar_index, session_open)
    line.set_xy2(session_open_line, bar_index + projection_offset, session_open)
    if show_session_open_label
        label.set_xy(session_open_label, bar_index + projection_offset, session_open)

// Manipulation Levels
if is_session_start and not na(avg_manipulation) and show_manipulation
    line.set_xy1(upper_manipulation_line, bar_index, session_open + avg_manipulation)
    line.set_xy2(upper_manipulation_line, bar_index + projection_offset, session_open + avg_manipulation)
    line.set_xy1(lower_manipulation_line, bar_index, session_open - avg_manipulation)
    line.set_xy2(lower_manipulation_line, bar_index + projection_offset, session_open - avg_manipulation)
    if show_manipulation_label
        label.set_xy(upper_manipulation_label, bar_index + projection_offset, session_open + avg_manipulation)
        label.set_xy(lower_manipulation_label, bar_index + projection_offset, session_open - avg_manipulation)

// Distribution Levels
if is_session_start and not na(avg_distribution) and show_distribution
    line.set_xy1(upper_distribution_line, bar_index, session_open + avg_distribution)
    line.set_xy2(upper_distribution_line, bar_index + projection_offset, session_open + avg_distribution)
    line.set_xy1(lower_distribution_line, bar_index, session_open - avg_distribution)
    line.set_xy2(lower_distribution_line, bar_index + projection_offset, session_open - avg_distribution)
    if show_distribution_label
        label.set_xy(upper_distribution_label, bar_index + projection_offset, session_open + avg_distribution)
        label.set_xy(lower_distribution_label, bar_index + projection_offset, session_open - avg_distribution)

// Median Levels
if is_session_start and not na(median_manipulation) and not na(median_distribution) and show_median
    line.set_xy1(upper_median_manip_line, bar_index, session_open + median_manipulation)
    line.set_xy2(upper_median_manip_line, bar_index + projection_offset, session_open + median_manipulation)
    line.set_xy1(lower_median_manip_line, bar_index, session_open - median_manipulation)
    line.set_xy2(lower_median_manip_line, bar_index + projection_offset, session_open - median_manipulation)
    line.set_xy1(upper_median_dist_line, bar_index, session_open + median_distribution)
    line.set_xy2(upper_median_dist_line, bar_index + projection_offset, session_open + median_distribution)
    line.set_xy1(lower_median_dist_line, bar_index, session_open - median_distribution)
    line.set_xy2(lower_median_dist_line, bar_index + projection_offset, session_open - median_distribution)
    if show_median_label
        label.set_xy(upper_median_manip_label, bar_index + projection_offset, session_open + median_manipulation)
        label.set_xy(lower_median_manip_label, bar_index + projection_offset, session_open - median_manipulation)
        label.set_xy(upper_median_dist_label, bar_index + projection_offset, session_open + median_distribution)
        label.set_xy(lower_median_dist_label, bar_index + projection_offset, session_open - median_distribution)

// Expansion Levels
if is_session_start and not na(mean_upward_expansion) and not na(mean_downward_expansion) and show_expansion
    line.set_xy1(upper_mean_expansion_line, bar_index, session_open + mean_upward_expansion)
    line.set_xy2(upper_mean_expansion_line, bar_index + projection_offset, session_open + mean_upward_expansion)
    line.set_xy1(lower_mean_expansion_line, bar_index, session_open - mean_downward_expansion)
    line.set_xy2(lower_mean_expansion_line, bar_index + projection_offset, session_open - mean_downward_expansion)
    if show_expansion_label
        label.set_xy(upper_mean_expansion_label, bar_index + projection_offset, session_open + mean_upward_expansion)
        label.set_xy(lower_mean_expansion_label, bar_index + projection_offset, session_open - mean_downward_expansion)

if is_session_start and not na(median_upward_expansion) and not na(median_downward_expansion) and show_expansion
    line.set_xy1(upper_median_expansion_line, bar_index, session_open + median_upward_expansion)
    line.set_xy2(upper_median_expansion_line, bar_index + projection_offset, session_open + median_upward_expansion)
    line.set_xy1(lower_median_expansion_line, bar_index, session_open - median_downward_expansion)
    line.set_xy2(lower_median_expansion_line, bar_index + projection_offset, session_open - median_downward_expansion)
    if show_expansion_label
        label.set_xy(upper_median_expansion_label, bar_index + projection_offset, session_open + median_upward_expansion)
        label.set_xy(lower_median_expansion_label, bar_index + projection_offset, session_open - median_downward_expansion)

// Range Median Level (midpoint between mean expansions)
if is_session_start and not na(mean_upward_expansion) and not na(mean_downward_expansion) and show_range_median
    float range_median_level = session_open + (mean_upward_expansion - mean_downward_expansion) / 2
    line.set_xy1(range_median_line, bar_index, range_median_level)
    line.set_xy2(range_median_line, bar_index + projection_offset, range_median_level)
    if show_range_median_label
        label.set_xy(range_median_label, bar_index + projection_offset, range_median_level)

// Shaded Areas
if is_session_start and not na(avg_manipulation) and not na(median_manipulation) and not na(avg_distribution) and not na(median_distribution) and show_shading
    box.set_lefttop(upper_manip_shading, bar_index, math.max(session_open + avg_manipulation, session_open + median_manipulation))
    box.set_rightbottom(upper_manip_shading, bar_index + projection_offset, math.min(session_open + avg_manipulation, session_open + median_manipulation))
    box.set_lefttop(lower_manip_shading, bar_index, math.max(session_open - avg_manipulation, session_open - median_manipulation))
    box.set_rightbottom(lower_manip_shading, bar_index + projection_offset, math.min(session_open - avg_manipulation, session_open - median_manipulation))
    box.set_lefttop(upper_dist_shading, bar_index, math.max(session_open + avg_distribution, session_open + median_distribution))
    box.set_rightbottom(upper_dist_shading, bar_index + projection_offset, math.min(session_open + avg_distribution, session_open + median_distribution))
    box.set_lefttop(lower_dist_shading, bar_index, math.max(session_open - avg_distribution, session_open - median_distribution))
    box.set_rightbottom(lower_dist_shading, bar_index + projection_offset, math.min(session_open - avg_distribution, session_open - median_distribution))

// Extend Lines, Labels, and Boxes Beyond Session
if bar_index > bar_index[1]
    if show_session_open
        line.set_x2(session_open_line, bar_index + projection_offset)
        if show_session_open_label
            label.set_x(session_open_label, bar_index + projection_offset)
    if show_manipulation
        line.set_x2(upper_manipulation_line, bar_index + projection_offset)
        line.set_x2(lower_manipulation_line, bar_index + projection_offset)
        if show_manipulation_label
            label.set_x(upper_manipulation_label, bar_index + projection_offset)
            label.set_x(lower_manipulation_label, bar_index + projection_offset)
    if show_distribution
        line.set_x2(upper_distribution_line, bar_index + projection_offset)
        line.set_x2(lower_distribution_line, bar_index + projection_offset)
        if show_distribution_label
            label.set_x(upper_distribution_label, bar_index + projection_offset)
            label.set_x(lower_distribution_label, bar_index + projection_offset)
    if show_median
        line.set_x2(upper_median_manip_line, bar_index + projection_offset)
        line.set_x2(lower_median_manip_line, bar_index + projection_offset)
        line.set_x2(upper_median_dist_line, bar_index + projection_offset)
        line.set_x2(lower_median_dist_line, bar_index + projection_offset)
        if show_median_label
            label.set_x(upper_median_manip_label, bar_index + projection_offset)
            label.set_x(lower_median_manip_label, bar_index + projection_offset)
            label.set_x(upper_median_dist_label, bar_index + projection_offset)
            label.set_x(lower_median_dist_label, bar_index + projection_offset)
    if show_expansion
        line.set_x2(upper_mean_expansion_line, bar_index + projection_offset)
        line.set_x2(lower_mean_expansion_line, bar_index + projection_offset)
        line.set_x2(upper_median_expansion_line, bar_index + projection_offset)
        line.set_x2(lower_median_expansion_line, bar_index + projection_offset)
        if show_expansion_label
            label.set_x(upper_mean_expansion_label, bar_index + projection_offset)
            label.set_x(lower_mean_expansion_label, bar_index + projection_offset)
            label.set_x(upper_median_expansion_label, bar_index + projection_offset)
            label.set_x(lower_median_expansion_label, bar_index + projection_offset)
    if show_range_median
        line.set_x2(range_median_line, bar_index + projection_offset)
        if show_range_median_label
            label.set_x(range_median_label, bar_index + projection_offset)
    if show_shading
        box.set_right(upper_manip_shading, bar_index + projection_offset)
        box.set_right(lower_manip_shading, bar_index + projection_offset)
        box.set_right(upper_dist_shading, bar_index + projection_offset)
        box.set_right(lower_dist_shading, bar_index + projection_offset)

// === Table Display ===
if show_table and barstate.islast
    var tbl = table.new(table_position == "Top Left" ? position.top_left : table_position == "Top Right" ? position.top_right : table_position == "Bottom Left" ? position.bottom_left : position.bottom_right, 2, 8, bgcolor=color.white, border_color=chart.fg_color, frame_color=chart.fg_color, frame_width=1, border_width=1)
    table.cell(tbl, 0, 0, display_session_name + " (" + session_time + ")", text_size=size.tiny, text_color=color.white, text_font_family=font.family_monospace, bgcolor=color.black)
    table.cell(tbl, 1, 0, "Total Sessions: " + str.tostring(array.size(session_types)), text_size=size.tiny, text_color=color.white, text_font_family=font.family_monospace, bgcolor=color.black)
    table.cell(tbl, 0, 1, "Bullish", text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 1, 1, str.tostring(bullish_count), text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 0, 2, "Bearish", text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 1, 2, str.tostring(bearish_count), text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 0, 3, "% Session Closes Above Manip", text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 1, 3, str.format("{0,number,#.##}%", pct_above_manip), text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 0, 4, "% Session Closes Below Manip", text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 1, 4, str.format("{0,number,#.##}%", pct_below_manip), text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 0, 5, "% Session Closes Above Dist", text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 1, 5, str.format("{0,number,#.##}%", pct_above_dist), text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 0, 6, "% Session Closes Below Dist", text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 1, 6, str.format("{0,number,#.##}%", pct_below_dist), text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 0, 7, "Avg Session Range", text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)
    table.cell(tbl, 1, 7, str.format("{0,number,#.##}", avg_session_range), text_color=color.black, text_size=size.small, text_font_family=font.family_monospace, bgcolor=color.white)

// === Alert Conditions ===
alertcondition(show_session_open and not na(session_open) and ta.crossover(close, session_open), title="Session Open Cross", message="Price crossed Session Open at {{close}}")
alertcondition(show_manipulation and not na(avg_manipulation) and not na(session_open) and ta.crossover(close, session_open + avg_manipulation), title="Upper Manipulation Cross", message="Price crossed -M at {{close}}")
alertcondition(show_manipulation and not na(avg_manipulation) and not na(session_open) and ta.crossover(close, session_open - avg_manipulation), title="Lower Manipulation Cross", message="Price crossed +M at {{close}}")
alertcondition(show_distribution and not na(avg_distribution) and not na(session_open) and ta.crossover(close, session_open + avg_distribution), title="Upper Distribution Cross", message="Price crossed +D at {{close}}")
alertcondition(show_distribution and not na(avg_distribution) and not na(session_open) and ta.crossover(close, session_open - avg_distribution), title="Lower Distribution Cross", message="Price crossed -D at {{close}}")
alertcondition(show_expansion and not na(mean_upward_expansion) and not na(session_open) and ta.crossover(close, session_open + mean_upward_expansion), title="Upper Expansion Mean Cross", message="Price crossed +Exp Mean at {{close}}")
alertcondition(show_expansion and not na(mean_downward_expansion) and not na(session_open) and ta.crossover(close, session_open - mean_downward_expansion), title="Lower Expansion Mean Cross", message="Price crossed -Exp Mean at {{close}}")
alertcondition(show_expansion and not na(median_upward_expansion) and not na(session_open) and ta.crossover(close, session_open + median_upward_expansion), title="Upper Expansion Median Cross", message="Price crossed +Exp Med at {{close}}")
alertcondition(show_expansion and not na(median_downward_expansion) and not na(session_open) and ta.crossover(close, session_open - median_downward_expansion), title="Lower Expansion Median Cross", message="Price crossed -Exp Med at {{close}}")
alertcondition(show_range_median and not na(mean_upward_expansion) and not na(mean_downward_expansion) and not na(session_open) and ta.crossover(close, session_open + (mean_upward_expansion - mean_downward_expansion) / 2), title="Range Median Cross", message="Price crossed Range Mid at {{close}}")
